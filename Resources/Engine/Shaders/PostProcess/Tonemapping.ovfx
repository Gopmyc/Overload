#shader vertex
#version 450 core

layout(location = 0) in vec2 geo_Pos;
layout(location = 1) in vec2 geo_TexCoords;

out vec2 TexCoords;

void main()
{
    TexCoords = geo_TexCoords;
    gl_Position = vec4(geo_Pos, 0.0, 1.0);
}

#shader fragment
#version 450 core

in vec2 TexCoords;
out vec4 FRAGMENT_COLOR;

uniform sampler2D _InputTexture;
uniform float _Exposure;
uniform int _Mode;
uniform int _GammaCorrection;
uniform float _Temperature;
uniform float _Tint;
uniform float _Saturation;
uniform float _Contrast;
uniform float _VignetteIntensity;
uniform float _VignetteSmoothness;

const float EPSILON = 0.0001;

float luminance(vec3 v)
{
    return max(dot(v, vec3(0.2126, 0.7152, 0.0722)), EPSILON);
}

vec3 applyGammaCorrection(vec3 color)
{
    const float gamma = 2.2;
    return pow(color, vec3(1.0 / gamma));
}

vec3 neutral(vec3 color)
{
    const float startCompression = 0.8 - 0.04;
    const float desaturation = 0.15;

    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= offset;

    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression) return color;

    const float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;

    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, vec3(newPeak), g);
}

vec3 reinhard(vec3 v)
{
    return v / (1.0f + v);
}

vec3 reinhard_jodie(vec3 v)
{
    float l = luminance(v);
    vec3 tv = v / (1.0 + v);
    return mix(v / (1.0 + l), tv, tv);
}

vec3 uncharted2_tonemap_partial(vec3 x)
{
    const float A = 0.15;
    const float B = 0.50;
    const float C = 0.10;
    const float D = 0.20;
    const float E = 0.02;
    const float F = 0.30;
    return ((x*(A*x+C*B)+D*E)/(x*(A*x+B)+D*F))-E/F;
}

vec3 uncharted2_filmic(vec3 v)
{
    float exposure_bias = 2.0f;
    vec3 curr = uncharted2_tonemap_partial(v * exposure_bias);

    vec3 W = vec3(11.2f);
    vec3 white_scale = vec3(1.0f) / uncharted2_tonemap_partial(W);
    return curr * white_scale;
}

vec3 ACESFilm(vec3 x)
{
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Warms or cools (temperature) and shifts towards green or magenta (tint), keeping the luminance
vec3 whiteBalance(vec3 color)
{
    const vec3 balance = vec3(1.0 + 0.1 * _Temperature, 1.0 - 0.1 * _Tint, 1.0 - 0.1 * _Temperature);
    return color * balance / luminance(balance);
}

// Contrast around middle grey, then saturation around the luminance, on the tonemapped (linear) colour
vec3 grade(vec3 color)
{
    const float middleGrey = 0.18;
    color = middleGrey * pow(max(color, vec3(0.0)) / middleGrey, vec3(_Contrast));
    return max(mix(vec3(luminance(color)), color, _Saturation), vec3(0.0));
}

// Darkens towards the corners: 0 at the centre, 1 in the corners
float vignette(vec2 uv)
{
    const float radius = length(uv - 0.5) * 1.41421356;
    return 1.0 - _VignetteIntensity * smoothstep(1.0 - _VignetteSmoothness, 1.0, radius);
}

void main()
{
    vec3 color = whiteBalance(texture(_InputTexture, TexCoords).rgb * _Exposure);

    switch(_Mode)
    {
        case 0: color = neutral(color); break;
        case 1: color = reinhard(color); break;
        case 2: color = reinhard_jodie(color); break;
        case 3: color = uncharted2_tonemap_partial(color); break;
        case 4: color = uncharted2_filmic(color); break;
        case 5: color = ACESFilm(color); break;
    }

    color = grade(color);

    if (_GammaCorrection != 0)
    {
        color = applyGammaCorrection(color);
    }

    FRAGMENT_COLOR = vec4(color * vignette(TexCoords), 1.0);
}
