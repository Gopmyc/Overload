// Matrices of the instances of an instanced draw (see Common/Instancing.ovfxh)
struct EngineInstance
{
    mat4 model;
    mat4 normalMatrix; // transpose(inverse(model)), use mat3(normalMatrix)
    mat4 userMatrix;
};

layout(std430, binding = 2) readonly buffer InstancesSSBO
{
    EngineInstance ssbo_Instances[];
};
