layout (std140, binding = 0) uniform EngineUBO
{
    mat4    ubo_Model;
    mat4    ubo_View;
    mat4    ubo_Projection;
    vec3    ubo_ViewPos;
    float   ubo_Time;
    mat4    ubo_UserMatrix;
    mat4    ubo_ViewProjection; // ubo_Projection * ubo_View
    mat4    ubo_NormalMatrix;   // transpose(inverse(ubo_Model)), use mat3(ubo_NormalMatrix)
    int     ubo_DepthOnly;      // 1 during the depth pre-pass: shaders can skip their shading once alpha testing is done
};
