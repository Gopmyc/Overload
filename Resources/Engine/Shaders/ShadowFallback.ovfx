#pass SHADOW_PASS
#engine_feature SKINNING

#shader vertex
#version 450 core

layout (location = 0) in vec3 geo_Pos;
#if defined(SKINNING)
layout (location = 5) in uvec4 geo_BoneIDs;
layout (location = 6) in vec4 geo_BoneWeights;
#endif

#include ":Shaders/Common/Buffers/EngineUBO.ovfxh"
#include ":Shaders/Common/Skinning.ovfxh"

void main()
{
    vec4 position = vec4(geo_Pos, 1.0);
#if defined(SKINNING)
    position = ComputeSkinningMatrix(geo_BoneIDs, geo_BoneWeights) * position;
#endif

    gl_Position = ubo_ViewProjection * (ubo_Model * position);
}

#shader fragment
#version 450 core

void main()
{
    // Depth-only pass: the depth is written by the fixed-function pipeline.
    // Writing gl_FragDepth here would disable early depth testing.
}
