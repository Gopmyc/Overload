<root>
    <shader>:Shaders/Particle.ovfx</shader>
    <settings>
        <cast_shadows>false</cast_shadows>
        <receive_shadows>false</receive_shadows>
        <blendable>true</blendable>
        <blend_mode>1</blend_mode>
        <backface_culling>false</backface_culling>
        <depth_test>true</depth_test>
        <depth_writing>false</depth_writing>
        <color_writing>true</color_writing>
        <gpu_instances>1</gpu_instances>
        <draw_order>1000</draw_order>
    </settings>
    <uniforms>
        <uniform><name>u_Tint</name><value><x>1</x><y>1</y><z>1</z><w>1</w></value></uniform>
        <uniform><name>u_Disc</name><value>1</value></uniform>
        <uniform><name>u_Softness</name><value>0.8</value></uniform>
        <uniform><name>u_Stretch</name><value>0.04</value></uniform>
    </uniforms>
</root>
