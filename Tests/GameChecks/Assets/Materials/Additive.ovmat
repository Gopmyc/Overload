<root>
    <shader>:Shaders/Unlit.ovfx</shader>
    <settings>
        <cast_shadows>false</cast_shadows>
        <receive_shadows>false</receive_shadows>
        <blendable>true</blendable>
        <blend_mode>1</blend_mode>
        <backface_culling>true</backface_culling>
        <depth_test>true</depth_test>
        <depth_writing>false</depth_writing>
        <color_writing>true</color_writing>
        <gpu_instances>1</gpu_instances>
        <draw_order>1000</draw_order>
    </settings>
    <uniforms>
        <uniform><name>u_Diffuse</name><value><x>1</x><y>0.45</y><z>0.1</z><w>0.6</w></value></uniform>
    </uniforms>
</root>
